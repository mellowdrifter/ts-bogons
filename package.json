{
  "name": "bogons",
  "version": "1.4.1",
  "type": "module",
  "description": "Lean, high-performance, zero-dependency IP and ASN bogon validation library with RFC descriptions",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/test_bogons.js"
  },
  "keywords": [
    "bogon",
    "bgp",
    "networking",
    "ip",
    "ipv4",
    "ipv6",
    "asn",
    "rfc",
    "cloudflare-workers"
  ],
  "author": "Darren O'Connor <mellow.drifter@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/mellowdrifter/ts-bogons.git"
  },
  "bugs": {
    "url": "https://github.com/mellowdrifter/ts-bogons/issues"
  },
  "homepage": "https://github.com/mellowdrifter/ts-bogons#readme"
}
